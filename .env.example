# ── Copy this file to `.env` and fill in real values before deploying. ──
# The `.env` file is read automatically by `docker compose`.

# Django ----------------------------------------------------------------------
# Generate a fresh key, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
# Comma-separated hostnames the backend will answer to.
ALLOWED_HOSTS=salyco.ir,www.salyco.ir,localhost
# Comma-separated origins (with scheme) trusted for the admin login CSRF check.
CSRF_TRUSTED_ORIGINS=https://salyco.ir,https://www.salyco.ir
# Used to build absolute links (e.g. warranty QR URLs).
FRONTEND_BASE_URL=https://salyco.ir

# Postgres --------------------------------------------------------------------
POSTGRES_DB=salyco
POSTGRES_USER=salyco
POSTGRES_PASSWORD=change-me-strong-db-password
